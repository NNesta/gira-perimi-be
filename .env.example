# Copy to .env and adjust. Every value has a safe development default (see app/core/config.py).

ENVIRONMENT=development

# REQUIRED in production: at least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Defaults to an SQLite file next to this one (gira_perimi.db).
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/gira_perimi.db

# Google Identity Services "Web application" OAuth client ID. Learners sign in only with Google; the frontend reads
# this value from GET /api/v1/auth/config. Looks like 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Proxy for the API's outbound calls (Google's token-signing keys). PythonAnywhere free accounts: http://proxy.server:3128
OUTBOUND_PROXY=

# Public address of the website (links in reminder emails).
SITE_URL=http://localhost:3000

# Opt-in daily reminder emails (`python -m app.cli send-reminders`, run once a day). Leave SMTP_HOST empty to switch
# reminders off: learners then never see the option. Gmail: smtp.gmail.com, port 587 and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Tsinda Neza <you@gmail.com>"

# Phone notifications (free; Android, and iPhone once the site is installed on the home screen). Generate the pair
# once with `python -m app.cli vapid-keys` and keep it: a new pair switches notifications off on every device.
# Leave empty to switch them off. VAPID_SUBJECT: a contact for the push services (mailto: or your https address).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Daily database backups (part of `python -m app.cli daily`): where the gzip copies go, and how long they are kept
# (every copy from the last BACKUP_KEEP_DAYS days, plus the first copy of each of the last BACKUP_KEEP_MONTHS months).
# BACKUP_DIR=/home/you/gira-perimi-be/backups
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=6

# Error alerts: the DSN of a Sentry project (sentry.io → Projects → your project → Client Keys). Empty = off.
SENTRY_DSN=

# "Watsinze ikizamini?": publish the real-exam pass rate once this many learners have answered.
OUTCOME_MIN_ANSWERS=10

# Origins allowed to call the API with cookies (the Next.js site).
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# How many of your servers add an address to X-Forwarded-For before a request reaches the API (admin sign-in is rate
# limited per visitor with it). The Next.js site counts as 1; add 1 if the API's host puts its own proxy in front of
# it (a load balancer that appends to the header). 0 = the API is reached directly: the header is ignored.
TRUSTED_PROXY_HOPS=1

# Forced to true in production; keep false for plain-http localhost.
COOKIE_SECURE=false

# Learner sessions (days) and admin sessions (hours).
USER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=8

# Readiness rule: recommended for the real exam after MORE than 10 mock exams, once the average of the 10 most recent
# is ABOVE 15/20. Abandoned exams (time ran out with under half the questions answered) do not count.
READINESS_MIN_EXAMS=10
READINESS_MIN_AVERAGE=15
READINESS_RECENT_EXAMS=10

# Future subscriptions: when true, practice, mock exams and non-free lessons need an active premium plan.
PAYWALL_ENABLED=false
